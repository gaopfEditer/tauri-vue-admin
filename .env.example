VITE_BASE_URL=/

VITE_APP_NAME=SoybeanAdmin
VITE_APP_TITLE=Soybean管理系统
VITE_APP_DESC=SoybeanAdmin是一个中后台管理系统模版

VITE_DESKTOP_API=Y
VITE_AUTH_ROUTE_MODE=dynamic
VITE_ROUTE_HOME_PATH=/dashboard/analysis

VITE_ICON_PREFFIX=icon
VITE_ICON_LOCAL_PREFFIX=icon-local

# 现场临时 SQLite
DB_DRIVER=sqlite
DB_SQLITE_PATH=database/sqlite/field-test.db

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=soybean_admin
DB_USER=root
DB_PASSWORD=

LICENSE_BYPASS=Y
LICENSE_SECRET=change-me
LICENSE_MASTER_KEY=change-me

MODBUS_POLL_ENABLED=Y
MODBUS_POLL_INTERVAL_SEC=5
MODBUS_POLL_LOG_DIR=logs
