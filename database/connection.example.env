# Soybean Admin 数据库连接配置示例
# 复制为后端项目的 .env 或 application-dev.yml 使用

# ---------------------------------------------------------------------------
# 本地 MySQL 初始化 (不用 Docker)
# ---------------------------------------------------------------------------
# Tauri Rust 后端读取项目根 .env 里的 DB_*（不是 VITE_ 前缀那套）
# 修改 DB_PASSWORD 后需重启 pnpm dev:tauri
# ---------------------------------------------------------------------------

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=soybean_admin
DB_USER=root
DB_PASSWORD=root

# JDBC (Java / Spring Boot)
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/soybean_admin?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# 连接池建议 (HikariCP)
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000

# 前端 .env-config.ts 中后端 API 地址 (当前项目默认)
VITE_SERVICE_BASE_URL=http://localhost:8080
